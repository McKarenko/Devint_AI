# Адрес, на котором слушает API. Локально только этот компьютер, не вся сеть.
API_HOST=127.0.0.1
# Порт API.
API_PORT=4000
# Режим: development, production или test.
NODE_ENV=development
# Куда писать письма. console — в терминал, только для разработки. disabled — не писать. В production без настоящего сервиса сервер не запускается.
MAIL_MODE=console
# Адрес сайта, с которого браузеру можно обращаться к API. Без пути.
WEB_ORIGIN=http://localhost:3000

# Сайт
NEXT_PUBLIC_APP_NAME=devint_ai
# Адрес API, который видит браузер.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Пользователь внутри PostgreSQL.
POSTGRES_USER=devint
# Пароль базы. Сгенерируй командой openssl rand -hex 24: в hex нет + / =, которые ломают адрес подключения. Настоящий пароль в репозиторий не класть.
POSTGRES_PASSWORD=ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ
# Имя базы.
POSTGRES_DB=devint
# Строка подключения API. Хост только 127.0.0.1, пароль тот же, что POSTGRES_PASSWORD.
DATABASE_URL=postgresql://devint:ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ@127.0.0.1:5432/devint
# Секрет для обезличенных ключей попыток входа. Не короче 32 символов. Настоящее значение только в .env, в репозиторий не класть.
LOGIN_THROTTLE_SECRET=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ_НЕ_КОРОЧЕ_32

