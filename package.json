{
  "name": "devint_ai",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @devint_ai/web dev",
    "dev:web": "pnpm --filter @devint_ai/web dev",
    "dev:api": "pnpm --filter @devint_ai/api dev",
    "build": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" build",
    "lint": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" lint",
    "typecheck": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
