# Адрес, на котором слушает API. Локально только этот компьютер, не вся сеть.
API_HOST=127.0.0.1
# Порт API.
API_PORT=4000
# Режим: development, production или test.
NODE_ENV=development
# Куда писать письма. console — в терминал, только для разработки. disabled — не писать. В production без настоящего сервиса сервер не запускается.
MAIL_MODE=console
# Адрес сайта, с которого браузеру можно обращаться к API. Без пути.
WEB_ORIGIN=http://localhost:3000

# Сайт
NEXT_PUBLIC_APP_NAME=devint_ai
# Адрес API, который видит браузер. Next не читает корневой .env.
# Для локального сайта скопируй эту строку в apps/web/.env.local.
# При сборке сайта, в том числе в Docker, переменная должна быть в окружении: она вшивается в страницы.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Пользователь внутри PostgreSQL.
POSTGRES_USER=devint
# Пароль базы. Сгенерируй командой openssl rand -hex 24: в hex нет + / =, которые ломают адрес подключения. Настоящий пароль в репозиторий не класть.
POSTGRES_PASSWORD=ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ
# Имя базы.
POSTGRES_DB=devint
# Строка подключения API. Хост только 127.0.0.1. Порт на компьютере 5433, внутри контейнера остаётся 5432.
DATABASE_URL=postgresql://devint:ЗАМЕНИ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ@127.0.0.1:5433/devint
# Секрет для обезличенных ключей попыток входа. Не короче 32 символов. Настоящее значение только в .env, в репозиторий не класть.
LOGIN_THROTTLE_SECRET=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ_НЕ_КОРОЧЕ_32
# Доверенный прокси. Локально не задавать: пустое значение его выключает. В production адрес Nginx задаёт docker-compose.prod.yml.
# TRUSTED_PROXY=172.28.10.10

# Только для docker-compose.prod.yml. Локальный docker-compose.yml их не использует.
# Пароли ролей базы: openssl rand -hex 24. В пароле только буквы и цифры, иначе скрипт ролей откажется.
# APP_DB_PASSWORD=
# MIGRATE_DB_PASSWORD=
# Домены без схемы. Это не адрес прослушивания API_HOST. Сертификат должен покрывать оба имени.
# WEB_DOMAIN=example.com
# API_DOMAIN=api.example.com
# Папка с fullchain.pem и privkey.pem. Сами файлы в репозиторий не класть.
# TLS_CERT_DIR=

